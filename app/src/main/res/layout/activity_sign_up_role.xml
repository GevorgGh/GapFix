<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gapfix_bg"
    tools:context=".SignUpRole">

    <!-- Header Frame for Back Button -->
    <FrameLayout
        android:id="@+id/backFr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Content Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@+id/backFr"
        app:layout_constraintBottom_toTopOf="@+id/button2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_your_role"
            android:textAlignment="center"
            android:textColor="@color/gapfix_green"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_sans"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ext_choose_how_you_want_to"
            android:textAlignment="center"
            android:textColor="@color/gapfix_text_secondary"
            android:textSize="16sp"
            android:fontFamily="@font/noto_sans"
            android:layout_marginBottom="40dp" />

        <!-- Tutor Card Selection -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tutorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_input_field"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/shop_clicked"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/tutor"
                android:textColor="@color/gapfix_green"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_sans"
                app:layout_constraintStart_toEndOf="@+id/imageView9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView4Sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/ext_share_your_expertise_guide_students"
                android:textColor="@color/gapfix_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/noto_sans"
                app:layout_constraintStart_toEndOf="@+id/imageView9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Student Card Selection -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/studentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_input_field"
            android:clickable="true"
            android:focusable="true"
            android:padding="20dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/imageView11"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/student"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/student"
                android:textColor="@color/gapfix_green"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_sans"
                app:layout_constraintStart_toEndOf="@+id/imageView11"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView6Sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/ext_find_expert_tutors_customize_schedules"
                android:textColor="@color/gapfix_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/noto_sans"
                app:layout_constraintStart_toEndOf="@+id/imageView11"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView6" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/gapfix_green"
        android:text="@string/cont"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="14dp"
        app:elevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>