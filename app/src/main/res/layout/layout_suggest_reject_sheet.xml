<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/color_slate_dark" />

        <!-- Header: Request Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/ivSheetStudentPhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/person_circle" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSheetStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_gev"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/gapfix_text_dark" />
                <TextView
                    android:id="@+id/tvSheetPackageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_applied_mathematics_package_12_lessons_2"
                    android:textSize="12sp"
                    android:textColor="@color/gapfix_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_slate_medium"
            android:layout_marginBottom="16dp" />

        <!-- Main Content Area: Split Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Request Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/color_slate_medium"
                app:cardBackgroundColor="@color/color_surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/request_summary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tvSheetSummaryTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ext_12_sessions_total" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvSheetSummaryStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ext_start_may_20_2026" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvSheetSummarySchedule" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ext_schedule_wed_thu_fri_12" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvSheetSummaryEnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ext_projected_end_jun_12_2026" android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Counter-Offer / Conflict Panel Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/counter_offer_action_panel"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <!-- ADDED ID HERE: cardConflictAction -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConflictAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/color_error_border"
                app:cardBackgroundColor="@color/color_error_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <!-- ADDED ID HERE: tvPanelHeaderTitle -->
                        <TextView
                            android:id="@+id/tvPanelHeaderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/conflicts_identified"
                            android:textStyle="bold"
                            android:textColor="@color/color_error"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rgChangeScope"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <RadioButton
                            android:id="@+id/rbScopeAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/change_pattern"
                            android:checked="true"
                            android:textSize="12sp"/>
                        <RadioButton
                            android:id="@+id/rbScopeSingle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/specific_lesson"
                            android:layout_marginStart="16dp"
                            android:textSize="12sp"/>
                    </RadioGroup>

                    <!-- Change Option for Bulk Pattern -->
                    <LinearLayout
                        android:id="@+id/layoutChangeOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_input_field"
                        android:backgroundTint="@color/color_accent_bg"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvSourcePatternLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/source_pattern_label"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/move_all" android:textSize="12sp"/>
                            <Spinner
                                android:id="@+id/spinnerSourceDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="120dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/destination_pattern_label"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/to_label" android:textSize="12sp"/>
                            <Spinner
                                android:id="@+id/spinnerDestDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="100dp"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDestTime"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ext_14_00"
                                android:textSize="12sp"
                                android:padding="0dp"
                                android:textColor="@color/gapfix_green"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBulkEffectPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ext_may_20_may_27_jun"
                            android:textSize="11sp"
                            android:textColor="@color/color_info"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <!-- Change Option for Single Lesson -->
                    <LinearLayout
                        android:id="@+id/layoutChangeSingleLesson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_input_field"
                        android:backgroundTint="@color/color_accent_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <!-- NEW: Dropdown context block -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ext_auto_select_lesson_to_reschedule"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/spinnerLessonsInPackage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ext_auto_select_new_date_amp_time"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDestDateSingle"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="@string/ext_auto_select_date"
                                android:textSize="12sp"
                                android:textColor="@color/gapfix_green"
                                app:strokeColor="@color/gapfix_green" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDestTimeSingle"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="@string/ext_auto_select_time"
                                android:textSize="12sp"
                                android:textColor="@color/gapfix_green"
                                app:strokeColor="@color/gapfix_green" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Decision Panel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/decision_panel"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSheetMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_optional_message"
                    android:minLines="2"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetSubmitCounter"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/submit_counter_offer"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/color_text_primary"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetRejectProposal"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/reject_proposal"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_close"
                    app:iconSize="14dp"
                    app:iconTint="@color/color_text_secondary"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetCancelAction"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/cancel_action"
                android:textAllCaps="false"
                android:textColor="@color/gapfix_text_secondary"
                app:strokeColor="@color/color_slate_medium"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>