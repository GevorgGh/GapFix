<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#D1D5DB" />

        <!-- Header: Request Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/ivSheetStudentPhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/person_circle" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSheetStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gev"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/gapfix_text_dark" />
                <TextView
                    android:id="@+id/tvSheetPackageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Applied Mathematics (Package - 12 lessons)"
                    android:textSize="12sp"
                    android:textColor="@color/gapfix_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginBottom="16dp" />

        <!-- Main Content Area: Split Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Left-ish: Request Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB"
                app:cardBackgroundColor="#F9FAFB">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/request_summary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tvSheetSummaryTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• 12 sessions total" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvSheetSummaryStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Start: May 20, 2026" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvSheetSummarySchedule" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Schedule: Wed/Thu/Fri @ 12:00" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tvSheetSummaryEnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Projected End: Jun 12, 2026" android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Counter-Offer / Conflict Panel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/counter_offer_action_panel"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FED7D7"
                app:cardBackgroundColor="#FFF5F5">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/conflicts_identified"
                            android:textStyle="bold"
                            android:textColor="#C53030"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rgChangeScope"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <RadioButton
                            android:id="@+id/rbScopeAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/change_pattern"
                            android:checked="true"
                            android:textSize="12sp"/>
                        <RadioButton
                            android:id="@+id/rbScopeSingle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/specific_lesson"
                            android:layout_marginStart="16dp"
                            android:textSize="12sp"/>
                    </RadioGroup>

                    <!-- Change Option -->
                    <LinearLayout
                        android:id="@+id/layoutChangeOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_input_field"
                        android:backgroundTint="#EBF4FF"
                        android:orientation="vertical"
                        android:padding="12dp">
                        
                        <TextView
                            android:id="@+id/tvSourcePatternLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/source_pattern_label"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/move_all" android:textSize="12sp"/>
                            <Spinner
                                android:id="@+id/spinnerSourceDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="120dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/destination_pattern_label"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/to_label" android:textSize="12sp"/>
                            <Spinner
                                android:id="@+id/spinnerDestDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="100dp"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDestTime"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14:00"
                                android:textSize="12sp"
                                android:padding="0dp"
                                android:textColor="@color/gapfix_green"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBulkEffectPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="May 20, May 27, Jun 03, Jun 10 → All moved to 14:00"
                            android:textSize="11sp"
                            android:textColor="#2B6CB0"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Decision Panel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/decision_panel"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSheetMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_optional_message"
                    android:minLines="2"
                    android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetSubmitCounter"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/submit_counter_offer"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2D3748"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetRejectProposal"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/reject_proposal"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#742A2A"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_close"
                    app:iconSize="14dp"
                    app:iconTint="@color/white"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSheetCancelAction"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/cancel_action"
                android:textAllCaps="false"
                android:textColor="@color/gapfix_text_secondary"
                app:strokeColor="#E2E8F0"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
