<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/color_slate_dark" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_book_regular_lesson"
                android:textColor="@color/gapfix_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleLessonType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnSingleLesson">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSingleLesson"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
        android:minHeight="48dp"
                    android:text="@string/ext_single_lesson"
                    android:textSize="11sp"
                    android:paddingHorizontal="12dp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPackage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
        android:minHeight="48dp"
                    android:text="@string/ext_package"
                    android:textSize="11sp"
                    android:paddingHorizontal="12dp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ext_select_subject"
            android:textColor="@color/gapfix_text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sheet_subjects_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <LinearLayout
            android:id="@+id/layoutSingleLesson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_select_schedule"
                android:textColor="@color/gapfix_text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetDate"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/ext_select_date"
                    android:textColor="@color/gapfix_text_dark"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    app:strokeColor="@color/color_slate_medium"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_calendar"
                    app:iconTint="@color/gapfix_green"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetTime"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/ext_select_time"
                    android:textColor="@color/gapfix_text_dark"
                    android:textAllCaps="false"
                    android:gravity="start|center_vertical"
                    app:strokeColor="@color/color_slate_medium"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_clock"
                    app:iconTint="@color/gapfix_green"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_lesson_quantity"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="@string/ext_minus"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="24dp" />
                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:text="@string/ext_12"
                    android:gravity="center"
                    android:background="@drawable/rounded_input_field"
                    android:layout_marginHorizontal="16dp"
                    android:textStyle="bold"
                    android:textSize="18sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="@string/ext_plus"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="24dp" />
            </LinearLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbProDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/ext_apply_5_pro_discount"
                android:textSize="12sp"
                app:buttonTint="@color/gapfix_green"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_1_set_global_start_date"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPackageStartDate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="@string/ext_choose_base_start_date"
                android:textColor="@color/gapfix_text_dark"
                android:textAllCaps="false"
                app:strokeColor="@color/color_slate_medium"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_calendar"
                app:iconTint="@color/gapfix_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_2_select_recurring_days"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupRecurringDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_3_set_time_for_each"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWeeklySlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvPackageDurationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ext_these_slots_will_be_booked"
                android:textSize="12sp"
                android:textAlignment="center"
                android:background="@color/color_slate_light"
                android:padding="8dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_booking_summary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <TextView android:id="@+id/tvSummarySubjectLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_no_subject_selected"
                    android:textSize="11sp"
                    android:textColor="@color/gapfix_text_secondary"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ext_subtotal" android:textSize="11sp" android:textColor="@color/gapfix_text_secondary"/>
                    <TextView android:id="@+id/tvSummarySubtotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_0_00" android:textSize="11sp" android:textColor="@color/gapfix_text_dark"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/layoutDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ext_discount_5" android:textSize="11sp" android:textColor="@color/color_error"/>
                    <TextView android:id="@+id/tvSummaryDiscount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ext_0_00" android:textSize="11sp" android:textColor="@color/color_error"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ext_fees" android:textSize="11sp" android:textColor="@color/gapfix_text_secondary"/>
                    <TextView android:id="@+id/tvSummaryFees" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_0_00" android:textSize="11sp" android:textColor="@color/gapfix_text_dark"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/color_slate_medium" android:layout_marginVertical="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ext_total" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/gapfix_text_dark"/>
                    <TextView android:id="@+id/tvSummaryTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/_0_00" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/gapfix_text_dark"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_select_payment_method"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:cardCornerRadius="8dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gapfix_green"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_google_logo" android:layout_marginEnd="6dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ext_card" android:textSize="11sp" android:textColor="@color/gapfix_text_dark" android:textStyle="bold"/>
                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:enabled="false"
                            app:buttonTint="@color/gapfix_green"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ext_i_agree_to_24_hour"
                    android:textSize="10sp"
                    app:buttonTint="@color/gapfix_green"/>

            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetConfirm"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="@string/ext_secure_payment_and_confirm_booking"
            android:backgroundTint="@color/gapfix_green"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tvTrialHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/ext_trial_is_30_mins_paid"
            android:textColor="@color/gapfix_text_secondary"
            android:textSize="10sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
