<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ForgotPass"
    android:background="@color/gapfix_bg">

    <!-- Header Frame for Back Button -->
    <FrameLayout
        android:id="@+id/backFr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/backFr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp"
            android:gravity="center_vertical">

            <!-- Illustration or Text Icon Header (Optional but beautiful, we'll use clean Text) -->
            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_forgot_password"
                android:textColor="@color/gapfix_green"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_sans"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_enter_your_email_below_and"
                android:textColor="@color/gapfix_text_secondary"
                android:textSize="16sp"
                android:fontFamily="@font/noto_sans"
                android:layout_marginBottom="32dp" />

            <!-- Email Input Field -->
            <EditText
                android:id="@+id/editTextText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/rounded_input_field"
                android:drawableStart="@drawable/input_envelope"
                android:drawablePadding="12dp"
                android:ems="10"
                android:hint="@string/prompt_email"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/gapfix_text_dark"
                android:textColorHint="@color/gapfix_text_secondary"
                android:textSize="16sp"
                android:fontFamily="@font/noto_sans" />

            <!-- Send Email Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/gapfix_green"
                android:text="@string/send_email"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:elevation="2dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>