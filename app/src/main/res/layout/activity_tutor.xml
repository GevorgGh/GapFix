<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Background Image (e.g. library/books) -->
                <ImageView
                    android:id="@+id/tutor_banner"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/person_circle" 
                    android:background="#F0F0F0" />

                <!-- Profile Image centered and overlapping -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/tutor_image"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="-40dp"
                    android:padding="4dp"
                    android:background="@color/white"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ProfileImageShape"
                    app:strokeColor="@color/gray"
                    app:strokeWidth="1dp"
                    tools:src="@drawable/person_circle" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <TextView
                    android:id="@+id/tutor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gapfix_text_dark"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="Gevorg" />

                <TextView
                    android:id="@+id/tutorPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/gapfix_text_secondary"
                    android:textSize="16sp"
                    android:text="Available Subjects &amp; Rates" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About Tutor"
                        android:textColor="@color/gapfix_text_secondary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tutor_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/gapfix_text_dark"
                        android:textSize="15sp"
                        tools:text="A passionate educator with 5+ years of experience..." />

                    <TextView
                        android:id="@+id/tv_member_since"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/gapfix_text_secondary"
                        android:textSize="13sp"
                        android:text="Member since 2021" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Specialties"
                        android:textColor="@color/gapfix_text_secondary"
                        android:textSize="18sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/tutor_subjects_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Reviews"
                        android:textColor="@color/gapfix_text_secondary"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Rating Summary -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingEnd="24dp">

                            <TextView
                                android:id="@+id/tv_avg_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5.0"
                                android:textColor="@color/gapfix_text_dark"
                                android:textSize="40sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Out of 5"
                                android:textColor="@color/gapfix_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_review_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="1 Review"
                                android:textColor="@color/gapfix_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Individual Review RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/reviews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/review_card" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookLesson"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/gapfix_green"
            android:text="Book Free Lesson"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="27dp" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
