<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/star_fill"
        app:tint="@color/gapfix_green"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvSubjectName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/gapfix_text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Mathematics" />

    <TextView
        android:id="@+id/tvPriceTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gapfix_green"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_package_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        tools:text="$20 • 60 mins" />

</LinearLayout>
