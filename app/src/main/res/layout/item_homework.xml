<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/color_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/rounded_icon_background"
                android:padding="8dp"
                android:src="@drawable/outline_assignment_24"
                app:tint="@color/gapfix_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHomeworkSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gapfix_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    android:textAllCaps="true"
                    android:layout_marginBottom="2dp"
                    android:text="@string/ext_subject"/>

                <TextView
                    android:id="@+id/tvHomeworkTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_math_homework_assignment"
                    android:textColor="@color/gapfix_text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeworkSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_click_to_view_file"
                    android:textColor="@color/gapfix_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnEditHomework"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/baseline_edit_24"
                    app:tint="@color/gapfix_green"
                    android:contentDescription="Edit Homework"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnDeleteHomework"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/color_error"
                    android:contentDescription="Delete Homework"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivArrowForward"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/outline_arrow_forward_24"
                    app:tint="@color/gapfix_text_secondary"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/homeworkDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_border"
            android:layout_marginVertical="12dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/layoutStudentActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginBottom="6dp"
                android:text="@string/ext_i_did_it_upload_pic"
                android:textSize="12sp"
                android:textColor="@color/color_success"
                app:strokeColor="@color/color_success_border"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFailed"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/ext_couldn_t_do_it"
                android:textSize="12sp"
                android:textColor="@color/color_error"
                app:strokeColor="@color/color_error_border"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSolutionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewSolution"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/ext_view_solution_picture"
                    android:textSize="11sp"
                    android:textColor="@color/color_info"
                    app:strokeColor="@color/color_info_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/outline_assignment_24"
                    app:iconSize="14dp"
                    app:iconPadding="4dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvFeedbackBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_awaiting_review"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_status_badge"
                    android:textColor="@color/color_warning" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTutorFeedbackActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2"
                android:visibility="gone"
                android:layout_marginTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkRight"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/ext_right"
                    android:textSize="12sp"
                    android:textColor="@color/color_success"
                    app:strokeColor="@color/color_success_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/outline_arrow_forward_24"
                    app:iconSize="14dp"
                    app:iconPadding="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkWrong"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/ext_wrong"
                    android:textSize="12sp"
                    android:textColor="@color/color_error"
                    app:strokeColor="@color/color_error_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_close"
                    app:iconSize="14dp"
                    app:iconPadding="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToArchive"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ext_add_to_archive"
            android:textColor="@color/gapfix_green"
            android:textSize="12sp"
            app:strokeColor="@color/gapfix_green"
            app:cornerRadius="8dp"
            app:icon="@drawable/archive"
            app:iconSize="16dp"
            app:iconPadding="8dp"
            app:iconTint="@color/gapfix_green"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/tvHomeworkStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/ext_status_pending"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_status_badge"
            android:textColor="@color/color_info"
            android:visibility="gone"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
