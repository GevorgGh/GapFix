<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gapfix_bg"
    tools:context=".IsVerifiedActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Custom premium icon envelope -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/baseline_email_24"
            app:tint="@color/gapfix_green"
            android:scaleType="centerInside"
            android:contentDescription="Verification email icon" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ext_verify_your_email"
            android:textColor="@color/gapfix_green"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_sans" />

        <!-- Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/ext_we_ve_sent_a_verification"
            android:textColor="@color/gapfix_text_secondary"
            android:textSize="16sp"
            android:fontFamily="@font/noto_sans"
            android:lineSpacingExtra="4dp" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerified"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="@color/gapfix_green"
            android:text="@string/ext_i_ve_verified_my_email"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="2dp" />

        <!-- Resend Link -->
        <TextView
            android:id="@+id/btnResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="@string/ext_resend_verification_email"
            android:textColor="@color/gapfix_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_sans"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>