<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/gapfix_bg">

    <!-- Top section: Logo and Subtitle -->
    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/actionContainer">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name"
            app:srcCompat="@drawable/logo_foreground" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ext_mind_the_gap_fix_the"
            android:textColor="@color/gapfix_text_secondary"
            android:textSize="18sp"
            android:fontFamily="@font/noto_sans"
            android:letterSpacing="0.05"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Bottom section: Actions -->
    <LinearLayout
        android:id="@+id/actionContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Google button styled as a premium modern card button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/google_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_input_field"
            android:clickable="true"
            android:focusable="true"
            android:elevation="0dp">

            <ImageView
                android:id="@+id/imageView10"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="24dp"
                android:contentDescription="@string/google"
                android:src="@drawable/ic_google_logo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/continue_with_google"
                android:textColor="@color/gapfix_text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_sans"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView10"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.3"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider with Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/color_slate_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_or"
                android:textColor="@color/gapfix_text_secondary"
                android:textSize="14sp"
                android:layout_marginHorizontal="16dp"
                android:fontFamily="@font/noto_sans" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/color_slate_dark" />
        </LinearLayout>

        <!-- Log In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_goto_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/gapfix_green"
            android:text="@string/log_in"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="2dp" />

        <!-- Create Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_goto_signup"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/create_account"
            android:textAllCaps="false"
            android:textColor="@color/gapfix_green"
            android:textSize="16sp"
            android:textStyle="bold"
            app:strokeColor="@color/gapfix_green"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/color_surface" />

        <!-- Test Login Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:paddingHorizontal="2dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_student"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Test Student"
                android:textAllCaps="false"
                android:textColor="@color/color_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="@color/color_slate_dark"
                app:strokeWidth="1.2dp"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/color_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_tutor"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Test Tutor"
                android:textAllCaps="false"
                android:textColor="@color/color_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="@color/color_slate_dark"
                app:strokeWidth="1.2dp"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/color_surface" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>