<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EEEEEE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivTutorPhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/person_circle"
                app:shapeAppearanceOverlay="@style/ProfileImageShape"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTutorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Tutor Name"
                android:textColor="@color/gapfix_text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivTutorPhoto"
                app:layout_constraintTop_toTopOf="@id/ivTutorPhoto" />

            <TextView
                android:id="@+id/tvSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject (Package · 12 lessons) [STATUS]"
                android:textColor="@color/gapfix_green"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/tvTutorName"
                app:layout_constraintTop_toBottomOf="@id/tvTutorName" />

            <!-- Top Right Info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:textColor="@color/gapfix_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_history"
                        app:tint="#555555" />
                    <TextView
                        android:id="@+id/tvSummaryPattern"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Pattern:\nMon/Wed\n(View List)"
                        android:textSize="9sp"
                        android:textColor="#555555" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Summary & Dates Section -->
        <LinearLayout
            android:id="@+id/layoutPackageSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:weightSum="2">

            <!-- Left: Summary -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Summary:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvSummaryStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Start: May 18, 2026."
                    android:textSize="11sp"
                    android:textColor="@color/gapfix_text_dark"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSummaryEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ End: Jun 12, 2026."
                    android:textSize="11sp"
                    android:textColor="@color/gapfix_text_dark" />
            </LinearLayout>

            <!-- Right: Selected Dates -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected Dates:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#555555"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDatesPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• May 18\n• May 20\n• May 22\n• May 25\n+ 8 more"
                    android:textSize="11sp"
                    android:textColor="@color/gapfix_text_dark"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviewCalendar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Review Calendar"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/gapfix_text_secondary"
                    app:strokeColor="@color/gapfix_green"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Toggle Button -->
        <TextView
            android:id="@+id/btn_expand_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="▼ View all lessons in package"
            android:textColor="@color/gapfix_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Expanded List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_package_lessons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone" />

        <!-- Suggestion Review Block -->
        <LinearLayout
            android:id="@+id/layout_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/rounded_input_field"
            android:backgroundTint="#FFF5F5"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Proposed Changes for Package"
                android:textColor="#C53030"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_suggestion_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Move Wednesdays to Tuesdays at 14:00"
                android:textSize="11sp"
                android:textColor="@color/gapfix_text_dark"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_suggestion_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&quot;Reason message here...&quot;"
                android:textSize="10sp"
                android:textStyle="italic"
                android:textColor="@color/gapfix_text_secondary"/>
        </LinearLayout>

        <!-- Footer Action Bar -->
        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review_changes"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Review / Change"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                app:backgroundTint="#8B0000"
                app:cornerRadius="12dp" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept_proposal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Accept Proposal"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/gapfix_green"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject_proposal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Reject"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:visibility="gone"
                app:backgroundTint="#742A2A"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Confirmed Action Bar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelStudent"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="12dp"
            android:text="Cancel / Change"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:visibility="gone"
            app:backgroundTint="#8B0000"
            app:cornerRadius="12dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
