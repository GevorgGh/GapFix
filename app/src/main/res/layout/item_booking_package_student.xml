<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/color_surface"
    app:strokeColor="@color/color_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivTutorPhoto"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/person_circle"
                app:shapeAppearanceOverlay="@style/ProfileImageShape"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTutorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="@string/ext_tutor_name"
                android:textColor="@color/gapfix_text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                app:layout_constraintStart_toEndOf="@id/ivTutorPhoto"
                app:layout_constraintTop_toTopOf="@id/ivTutorPhoto"
                app:layout_constraintEnd_toStartOf="@+id/layoutTopRightInfo" />

            <TextView
                android:id="@+id/tvSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/ext_subject_package_12_lessons_status"
                android:textColor="@color/gapfix_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="2"
                app:layout_constraintStart_toStartOf="@id/tvTutorName"
                app:layout_constraintTop_toBottomOf="@id/tvTutorName"
                app:layout_constraintEnd_toStartOf="@+id/layoutTopRightInfo" />

            <LinearLayout
                android:id="@+id/layoutTopRightInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_date"
                    android:textColor="@color/color_text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ext_12_00"
                    android:textColor="@color/gapfix_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/rounded_input_field"
                    android:backgroundTint="@color/gapfix_green_background"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/gapfix_green"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/tvSummaryPattern"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/ext_pattern_nmon_wed_n_view"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/gapfix_green" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/layoutPackageSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_border"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ext_summary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_secondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvSummaryStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ext_start_may_18_2026"
                        android:textSize="11sp"
                        android:textColor="@color/gapfix_text_dark"
                        android:layout_marginBottom="4dp"
                        android:drawablePadding="6dp"
                        app:drawableStartCompat="@drawable/baseline_calendar_today_24_small"
                        app:drawableTint="@color/color_text_muted" />

                    <TextView
                        android:id="@+id/tvSummaryEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ext_end_jun_12_2026"
                        android:textSize="11sp"
                        android:textColor="@color/gapfix_text_dark"
                        android:drawablePadding="6dp"
                        app:drawableStartCompat="@drawable/baseline_check_circle_24_small"
                        app:drawableTint="@color/gapfix_green" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ext_selected_dates"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_secondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvDatesPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ext_may_18_n_may_20"
                        android:textSize="11sp"
                        android:textColor="@color/gapfix_text_dark"
                        android:layout_marginBottom="12dp"
                        android:gravity="end"
                        android:lineSpacingExtra="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReviewCalendar"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ext_review_calendar"
                        android:textSize="10sp"
                        android:textAllCaps="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/gapfix_green"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_expand_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/ext_view_all_lessons_in_package_2"
            android:textColor="@color/gapfix_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@color/gapfix_green_background" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_package_lessons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/rounded_input_field"
            android:backgroundTint="@color/color_error_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_proposed_changes_for_package"
                android:textColor="@color/color_error"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_suggestion_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_move_wednesdays_to_tuesdays_at"
                android:textSize="12sp"
                android:textColor="@color/gapfix_text_dark"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_suggestion_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ext_quot_reason_message_here_quot"
                android:textSize="11sp"
                android:textStyle="italic"
                android:textColor="@color/gapfix_text_secondary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_review_changes"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/ext_review_change"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/color_error"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept_proposal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/ext_accept_proposal"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/gapfix_green"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject_proposal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/ext_reject"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:visibility="gone"
                app:backgroundTint="@color/color_text_secondary"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_margin="12dp"
            android:text="@string/ext_cancel_change"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:visibility="gone"
            app:backgroundTint="@color/color_error"
            app:cornerRadius="12dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
